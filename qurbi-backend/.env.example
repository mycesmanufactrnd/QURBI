PORT=3000
API_PREFIX=api
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5137

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=qurbidb
# Development only. Use false with reviewed migrations in production.
DB_SYNC=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

FIREBASE_PROJECT_ID=qurbi-f4254

# CHIP Collect (keep real keys in .env only)
PAYMENT_PROVIDER=chip
CHIP_MODE=test
CHIP_API_URL=https://gate.chip-in.asia/api/v1
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
CHIP_WEBHOOK_URL=
CHIP_WEBHOOK_PUBLIC_KEY_BASE64=
CHIP_SUCCESS_REDIRECT_URL=http://localhost:5137/payment/chip/success
CHIP_FAILURE_REDIRECT_URL=http://localhost:5137/payment/chip/failed
CHIP_CANCEL_REDIRECT_URL=http://localhost:5137/payment/chip/cancelled
CHIP_CURRENCY=MYR
CHIP_PAYMENT_EXPIRY_MINUTES=60

# Global request throttling.
MINIT=60000
LIMIT=100
