NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# XAMPP MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=qurbi

# Use true only while bootstrapping a disposable local database. Migrations
# must be used for shared/staging/production databases.
DB_SYNC=true

# Replace with a long random value in every real environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
