{
  "name": "Breed",
  "type": "object",
  "properties": {
    "breed_name": {
      "type": "string",
      "description": "Breed name"
    },
    "livestock_category_id": {
      "type": "string",
      "description": "Reference to LivestockCategory entity ID"
    },
    "origin": {
      "type": "string",
      "description": "Country or region of origin"
    },
    "image_url": {
      "type": "string",
      "description": "Image URL for the breed"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Whether this breed is shown in the marketplace"
    },
    "age_range": {
      "type": "string",
      "description": "Age range of the livestock (e.g. 2-3 years)",
      "default": ""
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Mixed"
      ],
      "default": "Mixed",
      "description": "Gender of the livestock"
    },
    "aa_price": {
      "type": "number",
      "description": "Price per head for Grade AA (RM)"
    },
    "a_price": {
      "type": "number",
      "description": "Price per head for Grade A (RM)"
    },
    "b_price": {
      "type": "number",
      "description": "Price per head for Grade B (RM)"
    },
    "c_price": {
      "type": "number",
      "description": "Price per head for Grade C (RM)"
    },
    "d_price": {
      "type": "number",
      "description": "Price per head for Grade D (RM)"
    }
  },
  "required": [
    "breed_name",
    "livestock_category_id"
  ]
}