VITE_API_BASE_URL=http://localhost:3000/api

# SEO / site address. VITE_SITE_URL is the public https origin of THIS app
# (used for canonical links, sitemap and social previews). Keep
# VITE_ALLOW_INDEXING unset everywhere except the real production site;
# without it the build tells search engines not to index anything.
VITE_SITE_URL=https://your-domain.com
VITE_ALLOW_INDEXING=false
